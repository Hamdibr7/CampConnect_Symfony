<script>
document.addEventListener('DOMContentLoaded', function () {
    const cart = [];
    let total = 0;

    // Création du popup
    const cartPopup = document.createElement('div');
    cartPopup.id = 'cartPopup';
    cartPopup.className = 'position-fixed bg-white shadow-lg p-3';
    cartPopup.style = 'top: 20px; right: 20px; width: 300px; z-index: 1050; display: none;';
    cartPopup.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="m-0">Votre panier</h5>
            <button class="btn btn-sm btn-outline-danger" id="closeCart">&times;</button>
        </div>
        <div id="cartItems" class="mb-3"></div>
        <div class="d-flex justify-content-between align-items-center border-top pt-2">
            <strong>Total:</strong>
            <span id="cartTotal" class="font-weight-bold">0 DT</span>
        </div>
        <button class="btn btn-success btn-block mt-2">Valider la commande</button>
    `;
    document.body.appendChild(cartPopup);

    // Bouton fermer
    document.getElementById('closeCart').addEventListener('click', () => {
        cartPopup.style.display = 'none';
    });

    // Gestion dynamique des "+" et "-"
    document.body.addEventListener('click', function (e) {
        if (e.target.matches('.btn-plus')) {
            const input = e.target.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value);
            const max = parseInt(input.getAttribute('max')) || 99;
            if (value < max) input.value = value + 1;
        }

        if (e.target.matches('.btn-minus')) {
            const input = e.target.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value);
            if (value > 1) input.value = value - 1;
        }

        if (e.target.matches('.btn-add-to-cart')) {
            const card = e.target.closest('.package-item') || e.target.closest('.product-card');
            const name = card.querySelector('a')?.textContent.trim() || 'Produit';
            const price = parseFloat(card.querySelector('.fa-tags').nextSibling.textContent.trim().split(' ')[0]) || 0;
            const quantity = parseInt(card.querySelector('.quantity-input').value);
            const image = card.querySelector('img')?.src || '';
            const id = card.dataset.id || name + price;

            const existing = cart.find(p => p.id === id);
            if (existing) {
                existing.quantity += quantity;
            } else {
                cart.push({ id, name, price, quantity, image });
            }

            total += price * quantity;
            updateCart();
            cartPopup.style.display = 'block';
        }

        if (e.target.closest('.delete-item')) {
            const btn = e.target.closest('.delete-item');
            const index = parseInt(btn.dataset.index);
            total -= cart[index].price * cart[index].quantity;
            cart.splice(index, 1);
            updateCart();
            if (cart.length === 0) cartPopup.style.display = 'none';
        }
    });

    // Sécurité sur les inputs quantité
    document.body.addEventListener('input', function (e) {
        if (e.target.classList.contains('quantity-input')) {
            let val = parseInt(e.target.value);
            const min = parseInt(e.target.getAttribute('min')) || 1;
            const max = parseInt(e.target.getAttribute('max')) || 99;

            if (isNaN(val) || val < min) e.target.value = min;
            else if (val > max) e.target.value = max;
        }
    });

    function updateCart() {
        const cartItems = document.getElementById('cartItems');
        cartItems.innerHTML = '';

        cart.forEach((item, i) => {
            const itemHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center">
                        <img src="${item.image}" alt="${item.name}" style="width: 40px; height: 40px; object-fit: cover;" class="mr-2">
                        <div>
                            <div class="font-weight-bold">${item.name}</div>
                            <small>${item.quantity} x ${item.price} DT</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="font-weight-bold mr-3">${(item.quantity * item.price).toFixed(2)} DT</div>
                        <button class="btn btn-sm btn-outline-danger delete-item" data-index="${i}">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            cartItems.insertAdjacentHTML('beforeend', itemHTML);
        });

        document.getElementById('cartTotal').textContent = total.toFixed(2) + ' DT';
    }
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {
    document.body.addEventListener('click', function (e) {
        // Bouton +
        if (e.target.closest('.btn-plus')) {
            const input = e.target.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value) || 1;
            const max = parseInt(input.max) || 99;
            if (value < max) {
                input.value = value + 1;
            }
        }

        // Bouton -
        if (e.target.closest('.btn-minus')) {
            const input = e.target.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value) || 1;
            const min = parseInt(input.min) || 1;
            if (value > min) {
                input.value = value - 1;
            }
        }
    });

    // Sécurisation de l'input en cas de saisie manuelle
    document.body.addEventListener('input', function (e) {
        if (e.target.classList.contains('quantity-input')) {
            let value = parseInt(e.target.value) || 1;
            const min = parseInt(e.target.min) || 1;
            const max = parseInt(e.target.max) || 99;

            if (value < min) {
                e.target.value = min;
            } else if (value > max) {
                e.target.value = max;
            }
        }
    });
});
</script>



<script>
    document.querySelectorAll('.ajouter-panier').forEach(button => {
        button.addEventListener('click', function () {
            const equipementDiv = this.closest('.equipement');

            const equipementId = equipementDiv.querySelector('.equipement-id')?.value;
            const prixUnitaire = equipementDiv.querySelector('.prix-unitaire')?.value;
            const quantite = equipementDiv.querySelector('.quantite')?.value;

            // 🐞 Débogage : Afficher les valeurs récupérées
            console.log("Valeurs récupérées :");
            console.log("ID Equipement :", equipementId);
            console.log("Prix Unitaire :", prixUnitaire);
            console.log("Quantité :", quantite);

            if (!equipementId || !prixUnitaire || !quantite) {
                alert("Erreur : données manquantes");
                return;
            }

            const postData = {
                id: equipementId,
                prix: prixUnitaire,
                quantite: quantite
            };

            // 🐞 Débogage : Afficher la requête envoyée
            console.log("Données envoyées :", postData);

            fetch('/ajouter-panier', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-TOKEN': '{{ csrf_token("ajouter_panier") }}'
                },
                body: JSON.stringify(postData)
            })
            .then(response => {
                console.log("Statut réponse :", response.status);
                return response.json();
            })
            .then(data => {
                // 🐞 Débogage : Afficher la réponse reçue
                console.log("Réponse du serveur :", data);

                if (data.success) {
                    alert('✅ Équipement ajouté au panier !');
                } else {
                    alert('❌ Erreur : ' + data.message);
                }
            })
            .catch(error => {
                console.error('🔥 Erreur AJAX attrapée :', error);
                alert('Erreur serveur.');
            });
        });
    });
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.btn-add-to-cart');

    buttons.forEach(button => {
        button.addEventListener('click', function () {
            const card = this.closest('.package-item');
            const equipementId = card.querySelector('.equipement-id').value;
            const prixUnitaire = card.querySelector('.prix-unitaire').value;
            const quantite = card.querySelector('.quantity-input').value;

            fetch('/panier/ajouter', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest' // utile si tu veux détecter les requêtes AJAX côté Symfony
                },
                body: JSON.stringify({
                    equipement_id: equipementId,
                    quantite: quantite,
                    prix_unitaire: prixUnitaire // tu peux l’envoyer même si on ne l’utilise pas
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Erreur : ' + data.error);
                } else {
                    alert('✅ ' + data.message);
                }
            })
            .catch(error => {
                console.error('Erreur AJAX :', error);
                alert('❌ Une erreur est survenue lors de l’ajout au panier.');
            });
        });
    });

    // Bonus : incrémentation/décrémentation du compteur
    document.querySelectorAll('.btn-plus').forEach(btn => {
        btn.addEventListener('click', function () {
            const input = this.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value);
            const max = parseInt(input.getAttribute('max'));
            if (value < max) input.value = value + 1;
        });
    });

    document.querySelectorAll('.btn-minus').forEach(btn => {
        btn.addEventListener('click', function () {
            const input = this.closest('.quantity-selector').querySelector('.quantity-input');
            let value = parseInt(input.value);
            if (value > 1) input.value = value - 1;
        });
    });
});
</script>



