{% extends 'base_front.html.twig' %}

{% block title %}Votre Panier{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2>Votre Panier</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Quantité</th>
                    <th>Prix Unitaire</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in panier %}
                    <tr>
                        <td>{{ item.equipement.nomEquip }}</td>
                        <td>{{ item.quantite }}</td>
                        <td>{{ item.equipement.prix|number_format(2, ',', ' ') }} €</td>
                        <td>{{ (item.equipement.prix * item.quantite)|number_format(2, ',', ' ') }} €</td>
                        <td>
                            <a href="{{ path('app_panier_supprimer', {'id': item.id}) }}" class="btn btn-danger">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="text-right">
            <form method="post" action="{{ path('app_panier_payer') }}">
                <button type="submit" class="btn btn-success">Payer</button>
            </form>
        </div>
    </div>
{% endblock %}
