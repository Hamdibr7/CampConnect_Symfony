    <!-- Script pour gérer le tri AJAX -->
    <script>
        $(document).ready(function() {
            // Gérer les clics sur les options de tri
            $('.sort-option').on('click', function(e) {
                e.preventDefault();

                var sortBy = $(this).data('sort-by');
                var sortDirection = $(this).data('sort-direction');

                // Afficher l'indicateur de chargement
                $('#loading-spinner').show();
                $('#user-grid-container').css('opacity', '0.5');

                // Récupérer les paramètres de filtrage actuels
                var query = $('input[name="query"]').val();
                var filters = [];
                $('input[name="filter[]"]:checked').each(function() {
                    filters.push($(this).val());
                });
                var letterFilter = '{{ letterFilter|default('') }}';
                var listType = '{{ listType|default('all') }}';

                // Construire les paramètres de la requête
                var params = {
                    sortBy: sortBy,
                    sort: sortDirection,
                    list: listType,
                    letter: letterFilter
                };
                if (query) {
                    params.query = query;
                }
                if (filters.length > 0) {
                    params['filter[]'] = filters;
                }

                // Envoyer la requête AJAX
                $.ajax({
                    url: '{{ path('app_amis') }}',
                    type: 'GET',
                    data: params,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        // Mettre à jour la grille d'utilisateurs
                        var html = '';
                        if (response.utilisateurs.length > 0) {
                            html += '<div class="user-grid">';
                            $.each(response.utilisateurs, function(index, utilisateur) {
                                html += '<div class="user-card">';
                                html += '<div class="user-header">';
                                html += '<div class="user-avatar-container">';
                                if (utilisateur.pdp) {
                                    html += '<img src="{{ asset('Uploads/profiles/') }}' + utilisateur.pdp + '" alt="Photo de profil" class="user-avatar">';
                                } else {
                                    html += '<div class="user-avatar-placeholder">' + utilisateur.prenom.charAt(0).toUpperCase() + utilisateur.nom.charAt(0).toUpperCase() + '</div>';
                                }
                                html += '</div>';
                                html += '<div class="user-info">';
                                html += '<div class="user-name">' + utilisateur.prenom + ' ' + utilisateur.nom + '</div>';
                                html += '<div class="user-age">' + utilisateur.age + ' ans</div>';
                                if (utilisateur.relation) {
                                    if (utilisateur.relation.status === 'attente') {
                                        if (utilisateur.relation.utilisateurid1 === {{ currentUser.id }}) {
                                            html += '<span class="badge badge-waiting">Invitation envoyée</span>';
                                        } else {
                                            html += '<span class="badge badge-waiting">Vous a invité</span>';
                                        }
                                    } else if (utilisateur.relation.status === 'amis') {
                                        html += '<span class="badge badge-friends">Ami</span>';
                                    } else if (utilisateur.relation.status === 'refusé') {
                                        html += '<span class="badge badge-rejected">Invitation refusée</span>';
                                    }
                                }
                                html += '</div>';
                                html += '</div>';
                                html += '<div class="user-actions">';
                                if (!utilisateur.relation) {
                                    html += '<a href="{{ path('app_amis_inviter', {'id': '__ID__'}) }}'.replace('__ID__', utilisateur.id) + '" class="btn btn-secondary"><i class="fas fa-user-plus"></i> Inviter</a>';
                                } else if (utilisateur.relation.status === 'attente') {
                                    if (utilisateur.relation.utilisateurid1 === {{ currentUser.id }}) {
                                        html += '<span class="btn btn-accent" style="cursor: default;"><i class="fas fa-clock"></i> Invitation envoyée</span>';
                                    } else {
                                        html += '<a href="{{ path('app_amis_accepter', {'id': '__ID__'}) }}'.replace('__ID__', utilisateur.relation.id) + '" class="btn btn-primary"><i class="fas fa-check"></i> Accepter</a>';
                                        html += '<a href="{{ path('app_amis_refuser', {'id': '__ID__'}) }}'.replace('__ID__', utilisateur.relation.id) + '" class="btn btn-danger"><i class="fas fa-times"></i> Refuser</a>';
                                    }
                                } else if (utilisateur.relation.status === 'amis') {
                                    html += '<span class="btn btn-primary" style="cursor: default;"><i class="fas fa-check-circle"></i> Déjà ami</span>';
                                } else if (utilisateur.relation.status === 'refusé') {
                                    html += '<span class="btn btn-danger" style="cursor: default;"><i class="fas fa-ban"></i> Invitation refusée</span>';
                                }
                                html += '</div>';
                                html += '</div>';
                            });
                            html += '</div>';
                        } else {
                            html += '<div class="no-results">';
                            html += '<i class="fas fa-search"></i>';
                            html += '<p>Aucun autre campeur disponible pour le moment</p>';
                            html += '</div>';
                        }

                        $('#user-grid-container').html(html);

                        // Mettre à jour le badge de tri
                        var badgeHtml = '';
                        if (response.sortBy === 'name') {
                            if (response.sortDirection === 'asc') {
                                badgeHtml = '<i class="fas fa-sort-alpha-down me-1"></i>Nom (A-Z)';
                            } else {
                                badgeHtml = '<i class="fas fa-sort-alpha-up me-1"></i>Nom (Z-A)';
                            }
                        } else if (response.sortBy === 'age') {
                            if (response.sortDirection === 'asc') {
                                badgeHtml = '<i class="fas fa-sort-numeric-down me-1"></i>Âge (croissant)';
                            } else {
                                badgeHtml = '<i class="fas fa-sort-numeric-up me-1"></i>Âge (décroissant)';
                            }
                        }
                        $('.current-sort .badge').html(badgeHtml);

                        // Mettre à jour les classes active dans le menu déroulant
                        $('.sort-option').removeClass('active');
                        $('.sort-option[data-sort-by="' + response.sortBy + '"][data-sort-direction="' + response.sortDirection + '"]').addClass('active');
                    },
                    error: function(xhr, status, error) {
                        console.error('Erreur AJAX:', error);
                    },
                    complete: function() {
                        // Cacher l'indicateur de chargement
                        $('#loading-spinner').hide();
                        $('#user-grid-container').css('opacity', '1');
                    }
                });
            });
        });
    </script>
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const searchForm = document.getElementById('search-form');
    const searchInput = document.getElementById('search-input');
    const searchButton = document.getElementById('search-button');
    const filterCheckboxes = document.querySelectorAll('.filter-checkbox');
    const searchResults = document.getElementById('search-results');
    
    // Fonction pour effectuer la recherche AJAX
    function performSearch() {
        // Récupérer la valeur de recherche
        const query = searchInput.value;
        
        // Récupérer les filtres sélectionnés
        const selectedFilters = [];
        filterCheckboxes.forEach(checkbox => {
            if (checkbox.checked) {
                selectedFilters.push(checkbox.value);
            }
        });
        
        // Construire l'URL de recherche
        let searchUrl = '{{ path('app_amis') }}?query=' + encodeURIComponent(query);
        
        // Ajouter les filtres à l'URL
        selectedFilters.forEach(filter => {
            searchUrl += '&filter[]=' + encodeURIComponent(filter);
        });
        
        // Indiquer que c'est une requête AJAX
        searchUrl += '&_ajax=1';
        
        // Afficher un indicateur de chargement
        searchResults.innerHTML = '<div class="loading">Chargement en cours...</div>';
        
        // Effectuer la requête AJAX
        fetch(searchUrl, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            // Traiter les résultats
            displayResults(data);
            
            // Mettre à jour l'URL du navigateur sans recharger la page
            window.history.pushState({}, '', searchUrl.replace('&_ajax=1', ''));
        })
        .catch(error => {
            console.error('Erreur lors de la recherche:', error);
            searchResults.innerHTML = '<div class="error">Une erreur est survenue lors de la recherche.</div>';
        });
    }
    
    // Fonction pour afficher les résultats
   // Fonction pour afficher les résultats
function displayResults(data) {
    if (!data.utilisateurs || data.utilisateurs.length === 0) {
        searchResults.innerHTML = '<div class="no-results">Aucun résultat trouvé.</div>';
        return;
    }
    
    // Construire le HTML pour les résultats
    let html = '<div class="user-grid">'; // Utiliser la même classe que dans votre design existant
    
    data.utilisateurs.forEach(utilisateur => {
        // Gestion de l'avatar comme dans votre code Twig
        let avatarHtml = '';
        if (utilisateur.pdp) {
            avatarHtml = `<img src="/Uploads/profiles/${utilisateur.pdp}" alt="Photo de profil" class="user-avatar">`;
        } else {
            // Créer les initiales à partir du prénom et nom
            const initiales = utilisateur.prenom.charAt(0).toUpperCase() + utilisateur.nom.charAt(0).toUpperCase();
            avatarHtml = `<div class="user-avatar-placeholder">${initiales}</div>`;
        }
        
        // Badge de statut
        let badgeHtml = '';
        if (!utilisateur.relation) {
            badgeHtml = '<span class="badge badge-new">Nouveau</span>';
        } else if (utilisateur.relation.status === 'attente') {
            if (utilisateur.relation.utilisateurid1 === data.currentUserId) {
                badgeHtml = '<span class="badge badge-sent">Invitation envoyée</span>';
            } else {
                badgeHtml = '<span class="badge badge-waiting">Demande reçue</span>';
            }
        } else if (utilisateur.relation.status === 'amis') {
            badgeHtml = '<span class="badge badge-friends">Ami</span>';
        }
        
        // Actions selon le statut de la relation
        let actionsHtml = '';
        if (!utilisateur.relation) {
            actionsHtml = `<a href="/amis/inviter/${utilisateur.id}" class="btn btn-primary"><i class="fas fa-user-plus"></i> Inviter</a>`;
        } else if (utilisateur.relation.status === 'attente') {
            if (utilisateur.relation.utilisateurid1 === data.currentUserId) {
                actionsHtml = `<button class="btn btn-secondary" disabled><i class="fas fa-clock"></i> En attente</button>`;
            } else {
                actionsHtml = `
                    <a href="/amis/accepter/${utilisateur.relation.id}" class="btn btn-primary"><i class="fas fa-check"></i> Accepter</a>
                    <a href="/amis/refuser/${utilisateur.relation.id}" class="btn btn-danger"><i class="fas fa-times"></i> Refuser</a>
                `;
            }
        } else if (utilisateur.relation.status === 'amis') {
            actionsHtml = `
                <a href="#" class="btn btn-primary"><i class="fas fa-comments"></i> Discuter</a>
                <a href="/amis/retirer/${utilisateur.relation.id}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir retirer cet ami ?');"><i class="fas fa-user-minus"></i> Retirer</a>
            `;
        }
        
        html += `
            <div class="user-card">
                <div class="user-header">
                    <div class="user-avatar-container">
                        ${avatarHtml}
                    </div>
                    <div class="user-info">
                        <div class="user-name">${utilisateur.prenom} ${utilisateur.nom}</div>
                        <div class="user-age">${utilisateur.age} ans</div>
                        ${badgeHtml}
                    </div>
                </div>
                <div class="user-actions">
                    ${actionsHtml}
                </div>
            </div>
        `;
    });
    
    html += '</div>';
    searchResults.innerHTML = html;
}
    
    // Événements
    searchButton.addEventListener('click', function(e) {
        e.preventDefault();
        performSearch();
    });
    
    searchInput.addEventListener('keyup', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            performSearch();
        }
    });
    
    filterCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', performSearch);
    });
    
    // Effectuer une recherche initiale si des paramètres sont déjà présents
    if (searchInput.value || document.querySelector('.filter-checkbox:checked')) {
        performSearch();
    }
});
</script>
   
</body>
</html>
