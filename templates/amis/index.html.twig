    <!-- Style personnalisé pour la page amis -->
    <style>
        :root {
            --primary-color: #2ecc71;
            --secondary-color: #3498db;
            --accent-color: #f39c12;
            --danger-color: #e74c3c;
            --dark-color: #2c3e50;
            --light-color: #ecf0f1;
            --gray-color: #95a5a6;
            --light-gray: #f4f6f8;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--light-color);
            color: var(--dark-color);
            margin: 0;
            padding: 0;
            background-image: linear-gradient(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.9)), 
                              url('/assets/images/camping-bg.jpg');
            background-size: cover;
            background-attachment: fixed;
        }

        .content-container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
            padding: 40px 0;
        }

        .page-header {
            text-align: center;
            padding: 20px 0 40px;
            position: relative;
        }

        .page-header h1 {
            font-size: 2.8em;
            margin-bottom: 15px;
            color: var(--primary-color);
            text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
            font-weight: 600;
        }

        .page-header::after {
            content: '';
            display: block;
            width: 100px;
            height: 4px;
            background-color: var(--accent-color);
            margin: 0 auto;
        }

        .flash-message {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: bold;
            text-align: center;
            animation: fadeIn 0.4s ease;
        }

        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .friends-section {
            margin-bottom: 50px;
            background-color: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--light-gray);
        }

        .section-header i {
            font-size: 1.6em;
            margin-right: 15px;
            color: var(--primary-color);
        }
        

        h2 {
            font-size: 1.8em;
            color: var(--dark-color);
            margin: 0;
            font-weight: 600;
        }

        .user-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .user-card {
            display: flex;
            flex-direction: column;
            background-color: var(--light-gray);
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .user-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        .user-header {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            background-color: white;
        }
        

      .user-avatar-container {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 15px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    background-color: var(--light-gray);
}

        .user-avatar {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-avatar-placeholder {
            width: 100%;
            height: 100%;
            background-color: var(--secondary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5em;
            font-weight: bold;
        }

        .user-info {
            flex-grow: 1;
        }

        .user-name {
            font-size: 1.2em;
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 5px;
        }

        .user-age {
            color: var(--gray-color);
            font-size: 0.9em;
        }

        .user-status {
            padding: 4px 8px;
            background-color: var(--accent-color);
            color: white;
            border-radius: 12px;
            font-size: 0.75em;
            display: inline-block;
            margin-top: 5px;
        }

        .user-actions {
            padding: 15px;
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.95em;
            cursor: pointer;
            text-decoration: none;
            border: none;
            font-weight: 600;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn i {
            margin-right: 5px;
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #27ae60;
            transform: translateY(-2px);
        }

        .btn-danger {
            background-color: var(--danger-color);
            color: white;
        }

        .btn-danger:hover {
            background-color: #c0392b;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background-color: var(--secondary-color);
            color: white;
        }

        .btn-secondary:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
        }

        .btn-accent {
            background-color: var(--accent-color);
            color: white;
        }

        .no-results {
            text-align: center;
            color: var(--gray-color);
            font-size: 1.1em;
            padding: 30px 0;
            font-style: italic;
        }

        .back-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 40px auto 20px;
            padding: 12px 25px;
            font-size: 1.1em;
            background-color: var(--dark-color);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            width: fit-content;
        }

        .back-btn i {
            margin-right: 8px;
        }

        .back-btn:hover {
            background-color: #1a252f;
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        /* Badge pour indiquer le statut */
        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: bold;
            color: white;
        }

        .badge-waiting {
            background-color: var(--accent-color);
        }

        .badge-friends {
            background-color: var(--primary-color);
        }

        .badge-rejected {
            background-color: var(--danger-color);
        }

        /* Animation de chargement */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .content-container {
                width: 95%;
            }
            
            .user-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            }
        }

        @media (max-width: 576px) {
            .user-grid {
                grid-template-columns: 1fr;
            }
            
            .page-header h1 {
                font-size: 2.2em;
            }
        }

        ///
        .search-container {
    background-color: white;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 30px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
}

.search-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.search-input-group {
    display: flex;
    width: 100%;
}

.search-input {
    flex-grow: 1;
    padding: 12px 15px;
    border: 2px solid var(--light-gray);
    border-radius: 8px 0 0 8px;
    font-size: 1rem;
    transition: border-color 0.3s;
}

.search-input:focus {
    outline: none;
    border-color: var(--primary-color);
}

.search-button {
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 0 8px 8px 0;
    padding: 0 20px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.search-button:hover {
    background-color: #27ae60;
}

.search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.filter-option {
    display: flex;
    align-items: center;
    gap: 5px;
    background-color: var(--light-gray);
    padding: 8px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.filter-option:hover {
    background-color: #e2e6ea;
}

.filter-option input {
    cursor: pointer;
}
    .user-nav-link .profile-mini {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 5px;
            object-fit: cover;
            border: 2px solid var(--primary);
        }
        .user-dropdown-menu {
      margin-top: 10px;
      border-radius: 8px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      border: none;
      min-width: 200px;
    }
    
    .user-dropdown-item {
      padding: 10px 20px;
      transition: all 0.3s;
    }
    
    .user-dropdown-item:hover {
      background-color: #f8f9fa;
      color: var(--primary);
    }
    
    .user-dropdown-item i {
      margin-right: 10px;
      color: var(--primary);
    }
    
    .user-avatar-placeholder {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: bold;
      color: white;
      border: 2px solid var(--primary);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
        
@media (max-width: 768px) {
    .search-filters {
        flex-direction: column;
        gap: 10px;
    }
    
    .filter-option {
        width: fit-content;
    }
}
    </style>
</head>

<body>
