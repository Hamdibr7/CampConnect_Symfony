          <h1 class="m-0 text-primary"><span class="text-dark">CAMP</span>CONNECT</h1>
        </a>
        <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
          <span class="navbar-toggler-icon"></span>
        </button>
