/* Styles pour les indicateurs d'état de la recherche AJAX */
.loading {
    text-align: center;
    padding: 20px;
    color: #666;
}

.error {
    text-align: center;
    padding: 20px;
    color: #d9534f;
    background-color: #f2dede;
    border-radius: 4px;
    margin: 10px 0;
}

.no-results {
    text-align: center;
    padding: 20px;
    color: #666;
    background-color: #f9f9f9;
    border-radius: 4px;
    margin: 10px 0;
}

/* Styles pour la liste des résultats */
.utilisateurs-list {
    margin-top: 20px;
}

.utilisateur-card {
