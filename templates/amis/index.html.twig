        }

        .dropdown-item {
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            color: #4b5563;
        }

        .dropdown-item:hover {
            background-color: #f3f4f6;
        }

        .dropdown-item.active {
            background-color: rgba(74, 134, 232, 0.1);
            color: #4a86e8;
