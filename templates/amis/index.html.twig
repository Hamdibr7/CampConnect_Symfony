                    <i class="fas fa-user-shield mr-1"></i> Administrateur
                  {% else %}
                    <div class="user-avatar-placeholder">
                      {{ user.prenom is defined ? user.prenom|first|upper : '' }}{{ user.nom is defined ? user.nom|first|upper : '' }}
                    </div>
                  {% endif %}

                  {% if user.isAdmin is not defined or not user.isAdmin %}
                    {% if user.prenom is defined or user.nom is defined %}
                      {{ user.prenom|default('') }} {{ user.nom|default('') }}
                    {% endif %}
