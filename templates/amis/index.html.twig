}

/* Styles pour les filtres */
.search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 10px;
}

.filter-option {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
