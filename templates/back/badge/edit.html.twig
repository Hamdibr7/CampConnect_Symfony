{% extends 'CRUD.html.twig' %}

{% block title %}Modifier le badge{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <h1 class="mb-4">Modifier le badge</h1>

    <a href="{{ path('app_badge_index') }}" class="btn btn-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Retour à la liste des badges
    </a>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.nom_badge) }}
            {{ form_widget(form.nom_badge, { 'attr': {'class': 'form-control'} }) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, { 'attr': {'class': 'form-control'} }) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.reservations_requises) }}
            {{ form_widget(form.reservations_requises, { 'attr': {'class': 'form-control'} }) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, { 'attr': {'class': 'form-control'} }) }}
        </div>

        {% if badge.image %}
            <div class="mb-3">
                <label>Image actuelle :</label><br>
                <img src="{{ asset('uploads/badges/' ~ badge.image) }}" alt="Badge" class="img-thumbnail" style="max-width: 150px;">
            </div>
        {% endif %}

        <button class="btn btn-warning" type="submit">
            <i class="fas fa-save"></i> Mettre à jour le badge
        </button>
    {{ form_end(form) }}
{% endblock %}
