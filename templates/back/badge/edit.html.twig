{% extends 'CRUD.html.twig' %}
{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

{% block title %}Modifier le badge{% endblock %}

{% block body %}
    <h1>Modifier le badge</h1>

    <a href="{{ path('app_badge_index') }}" class="btn btn-secondary">Retour à la liste des badges</a>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.nom_badge) }}
            {{ form_widget(form.nom_badge, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.reservations_requises) }}
            {{ form_widget(form.reservations_requises, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, { 'attr': {'class': 'form-control'} }) }}
        </div>

        <button class="btn btn-warning" type="submit">Mettre à jour le badge</button>
    {{ form_end(form) }}
{% endblock %}
