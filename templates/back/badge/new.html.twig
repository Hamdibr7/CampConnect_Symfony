{% extends 'CRUD.html.twig' %}

{% block title %}Ajouter un nouveau badge{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <h1 class="mb-4">Ajouter un nouveau badge</h1>

    <a href="{{ path('app_badge_index') }}" class="btn btn-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Retour à la liste des badges
    </a>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.nom_badge) }}
            {{ form_widget(form.nom_badge, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.nom_badge) }}
        </div>
        
        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.description) }}
        </div>
        
        <div class="mb-3">
            {{ form_label(form.reservations_requises) }}
            {{ form_widget(form.reservations_requises, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.reservations_requises) }}
        </div>
        
        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.imageFile) }}
        </div>

        <button class="btn btn-success" type="submit">
            <i class="fas fa-check"></i> Créer le badge
        </button>
    {{ form_end(form) }}
{% endblock %}
