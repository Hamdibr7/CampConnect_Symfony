{% extends 'CRUD.html.twig' %}

{% block title %}Liste des Réservations{% endblock %}

{% block css %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="card">
            <h2 class="mb-4"><i class="fas fa-calendar-alt me-2"></i>Liste des Réservations</h2>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Camping</th>
                            <th scope="col">Location</th>
                            <th scope="col">Dates</th>
                            <th scope="col">User ID</th>
                            <th scope="col">Montant</th>
                            <th scope="col">Image</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if reservations is not empty %}
                            {% for reservation in reservations %}
                                <tr>
                                    <td>{{ reservation.id }}</td>
                                    <td>
                                        <strong>{{ reservation.camping.nom }}</strong><br>
                                    </td>
                                    <td>
                                        {{ reservation.camping.adresse }}<br>
                                        {{ reservation.camping.ville }}, {{ reservation.camping.pays }}
                                    </td>
                                    <td>
                                        {{ reservation.camping.Date_Deb|date('d/m/Y') }}<br>
                                        <span class="text-muted">à</span><br>
                                        {{ reservation.camping.Date_Fin|date('d/m/Y') }}
                                    </td>
                                    <td>{{ reservation.utilisateurid }}</td>
                                    <td>{{ reservation.montant|number_format(3, '.', ' ') }} DT</td>
                                    <td>
                                        {% if reservation.camping.image %}
                                            <img src="{{ asset('uploads/campings/' ~ reservation.camping.image) }}"
                                                 alt="{{ reservation.camping.nom }}"
                                                 style="height: 60px; border-radius: 8px;"
                                                 class="shadow-sm border">
                                        {% else %}
                                            <span class="text-muted">Aucune image</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted">Aucune réservation trouvée</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
