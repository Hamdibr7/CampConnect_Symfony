{% extends 'base.html.twig' %}

{% block title %}Assistant Virtuel{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Styles améliorés pour le chat */
    #chat-box {
        height: 60vh;
        overflow-y: auto;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
    }
    
    .message {
        margin-bottom: 12px;
        clear: both;
    }
    
    .user-message {
        text-align: right;
    }
    
    .user-message .message-content {
        display: inline-block;
        background: #007bff;
        color: white;
        padding: 10px 15px;
        border-radius: 18px 18px 0 18px;
        max-width: 80%;
    }
    
    .bot-message {
        text-align: left;
    }
    
    .bot-message .message-content {
        display: inline-block;
        background: #e9ecef;
        color: #212529;
        padding: 10px 15px;
        border-radius: 18px 18px 18px 0;
        max-width: 80%;
    }
    
    .welcome-message {
        text-align: center;
        color: #6c757d;
        padding: 20px 0;
    }
</style>
{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">
                <i class="fas fa-robot me-2"></i> Assistant Virtuel
            </h2>
            <a href="{{ path('app_front_reclamations') }}" class="btn btn-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>
        
        <div class="card-body">
            <!-- Conteneur de chat -->
            <div id="chat-box">
                <div class="welcome-message">
                    <i class="fas fa-comments fa-3x mb-3"></i>
                    <p>Posez-moi vos questions sur les réclamations...</p>
                </div>
            </div>
            
            <!-- Formulaire d'envoi -->
            <form id="chat-form" class="mt-3">
                <div class="input-group">
                    <input type="text" id="user-message" class="form-control" placeholder="Écrivez votre message..." required autocomplete="off">
                    <button type="submit" class="btn btn-success" id="send-button">
                        <i class="fas fa-paper-plane"></i> Envoyer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chatForm = document.getElementById('chat-form');
    const userInput = document.getElementById('user-message');
    const chatBox = document.getElementById('chat-box');
    const sendButton = document.getElementById('send-button');

    // Fonction pour ajouter un message dans le chat
    function addMessage(sender, content) {
        // Supprimer le message de bienvenue si c'est le premier message
        if (document.querySelector('.welcome-message')) {
            chatBox.innerHTML = '';
        }
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${sender}-message`;
        messageDiv.innerHTML = `
            <div class="message-content">
                ${content}
            </div>
        `;
        chatBox.appendChild(messageDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    // Gestion de l'envoi du formulaire
    chatForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        const message = userInput.value.trim();
        
        if (message) {
            // Désactiver le bouton pendant l'envoi
            sendButton.disabled = true;
            sendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Envoi...';
            
            // Ajouter le message de l'utilisateur
            addMessage('user', message);
            userInput.value = '';
            
            try {
                // Envoyer la requête au backend
           const response = await fetch("{{ path('app_chat_api') }}", {
    method: 'POST',
    headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
    },
    body: `message=${encodeURIComponent(message)}`
});
                
                const data = await response.json();
                
                if (data.response) {
                    addMessage('bot', data.response);
                } else if (data.error) {
                    addMessage('bot', `Erreur: ${data.error}`);
                } else {
                    addMessage('bot', "Désolé, je n'ai pas pu obtenir de réponse.");
                }
            } catch (error) {
                addMessage('bot', "Erreur de connexion avec le serveur.");
                console.error('Erreur:', error);
            } finally {
                // Réactiver le bouton
                sendButton.disabled = false;
                sendButton.innerHTML = '<i class="fas fa-paper-plane"></i> Envoyer';
            }
        }
    });

    // Permettre d'envoyer avec la touche Entrée
    userInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            chatForm.dispatchEvent(new Event('submit'));
        }
    });
});
</script>
{% endblock %}