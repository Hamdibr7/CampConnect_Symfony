        <!-- Booking Start -->
<div class="container-fluid booking mb-5">
    <div class="container pb-5">
        <div style="padding: 20px;">
<form method="get" action="{{ path('reservation_index') }}">
    <div class="row align-items-center" style="min-height: 60px;">
        <div class="col-md-10">
            <div class="row">
                <div class="col-md-3">
                    <input type="text" name="camping" class="form-control px-4" placeholder="Nom du camping" value="{{ filters.camping }}">
                </div>
                <div class="col-md-3">
                    <input type="date" name="dateDebut" class="form-control px-4" placeholder="Date de début" value="{{ filters.dateDebut }}">
                </div>
                <div class="col-md-3">
                    <input type="number" step="0.01" name="montant" class="form-control px-4" placeholder="Montant (DT)" value="{{ filters.montant }}">
                </div>
                <div class="col-md-3">
                    <input type="text" name="ville" class="form-control px-4" placeholder="Ville" value="{{ filters.ville }}">
                </div>
            </div>
        </div>

        <div class="col-md-2 mt-3 mt-md-0">
            <div class="d-flex">
                <button class="btn btn-primary mr-2" type="submit" style="height: 47px;">Rechercher</button>
                <button class="btn btn-secondary" type="submit" name="sort" value="{{ filters.sort == 'asc' ? 'desc' : 'asc' }}" title="Trier par date" style="height: 47px;">
                    {% if filters.sort == 'asc' %}
                        <i class="fas fa-sort-amount-down-alt"></i>
                    {% else %}
                        <i class="fas fa-sort-amount-up-alt"></i>
                    {% endif %}
                </button>
            </div>
        </div>
    </div>
</form>




        </div>
    </div>
</div>
<!-- Booking End -->


        <!-- Reservation Cards -->
        <div class="row">
            {% if reservations is defined and reservations|length > 0 %}
                {% for reservation in reservations %}
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="reservation-card bg-white p-4 shadow rounded h-100">
                            <div class="text-center mb-3">
                                {% if reservation.camping.image %}
                                    <img class="img-fluid rounded-circle"
                                         src="{{ asset('uploads/badges/' ~ reservation.camping.image) }}"
                                         style="width: 80px; height: 80px; object-fit: cover;"
                                         alt="{{ reservation.camping.nom }}"
                                         onerror="this.onerror=null;this.src='{{ asset('img/default-camping.jpg') }}'">
                                {% else %}
                                    <img class="img-fluid rounded-circle"
                                         src="{{ asset('img/default-camping.jpg') }}"
                                         style="width: 80px; height: 80px; object-fit: cover;"
                                         alt="Default camping image">
                                {% endif %}
                            </div>

                            <h4 class="text-primary text-center">{{ reservation.camping.nom }}</h4>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fa fa-calendar-alt text-primary mr-2"></i>Date de début :</span>
                                <span>{{ reservation.camping.Date_Deb|date('M d, Y') }}</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fa fa-calendar-alt text-primary mr-2"></i>Date de fin :</span>
                                <span>{{ reservation.camping.Date_Fin|date('M d, Y') }}</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fa fa-map-marker-alt text-primary mr-2"></i>Emplacement :</span>
                                <span>{{ reservation.camping.ville }}, {{ reservation.camping.pays }}</span>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span><i class="fa fa-dollar-sign text-primary mr-2"></i>Amount:</span>
                                <span>DT {{ reservation.montant|number_format(2) }}</span>
                            </div>

                            <div class="text-center mt-3">
                                {% if reservation.camping.Date_Deb|date("Y-m-d") > "now"|date("Y-m-d") %}
                                    <form method="post" action="{{ path('reservation_delete', {'id': reservation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete ' ~ reservation.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                            <i class="fa fa-times mr-1"></i> Annuler
                                        </button>
                                    </form>
                                {% else %}
                                    <div class="btn btn-sm" style="background-color: #f8d7da; color: #721c24; cursor: not-allowed;" disabled>
                                        <i class="fa fa-ban mr-1"></i> Annulation indisponible
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
                

            {% else %}
                <div class="col-12">
                    <div class="no-reservations bg-white p-5 rounded text-center">
                        <i class="fa fa-calendar-times fa-3x text-primary mb-4"></i>
                        <h4 class="text-dark mb-3">No Reservations Yet</h4>
                        <a href="{{ path('front_landing') }}" class="btn btn-primary px-4">
                            <i class="fa fa-search mr-2"></i> Browse Campings
                        </a>
                    </div>
                </div>
            {% endif %}
