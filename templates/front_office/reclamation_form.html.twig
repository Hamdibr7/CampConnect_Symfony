{% extends 'base.html.twig' %}

{% block title %}{{ edit_mode ? 'Modifier la Réclamation' : 'Nouvelle Réclamation' }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_front_reclamations') }}">Mes Réclamations</a></li>
            {% if edit_mode %}
                <li class="breadcrumb-item"><a href="{{ path('app_front_reclamation_view', {id: reclamation.id}) }}">Réclamation #{{ reclamation.id }}</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            {% else %}
                <li class="breadcrumb-item active">Nouvelle Réclamation</li>
            {% endif %}
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">{{ edit_mode ? 'Modifier la Réclamation' : 'Nouvelle Réclamation' }}</h3>
        </div>
        <div class="card-body">
            {{ form_start(form, { 'attr': {'id': 'reclamation-form'} }) }}

            {# Bloc global d’erreurs #}
            {% if not form.vars.valid %}
                <div id="form-errors" class="alert alert-danger">
                    Le formulaire contient des erreurs. Veuillez corriger les champs signalés ci-dessous.
                </div>
            {% endif %}

            {# Champ Camping #}
            <div class="mb-3">
                {{ form_row(form.camping, {'attr': {'class': 'form-select'}}) }}
            </div>

            {# Champ Description #}
            <div class="mb-3">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    {{ edit_mode ? 'Enregistrer les modifications' : 'Soumettre la réclamation' }}
                </button>
                {% if edit_mode %}
                    <a href="{{ path('app_front_reclamation_view', {id: reclamation.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                {% else %}
                    <a href="{{ path('app_front_reclamations') }}" class="btn btn-outline-secondary">Annuler</a>
                {% endif %}
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>


{% endblock %}
