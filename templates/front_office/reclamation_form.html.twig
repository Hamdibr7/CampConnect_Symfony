{% extends 'base.html.twig' %}

{% block title %}{{ edit_mode ? 'Modifier la Réclamation' : 'Nouvelle Réclamation' }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_front_reclamations') }}">Mes Réclamations</a></li>
            {% if edit_mode %}
                <li class="breadcrumb-item"><a href="{{ path('app_front_reclamation_view', {id: reclamation.id}) }}">Réclamation #{{ reclamation.id }}</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            {% else %}
                <li class="breadcrumb-item active">Nouvelle Réclamation</li>
            {% endif %}
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">{{ edit_mode ? 'Modifier la Réclamation' : 'Nouvelle Réclamation' }}</h3>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.camping) }}
                    {{ form_widget(form.camping, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.camping) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}

                    {# Affichage personnalisé des erreurs de la description #}
                    {% for error in form.description.vars.errors %}
                        <div class="alert alert-danger mt-2">{{ error.message }}</div>
                    {% endfor %}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        {{ edit_mode ? 'Enregistrer les modifications' : 'Soumettre la réclamation' }}
                    </button>
                    {% if edit_mode %}
                        <a href="{{ path('app_front_reclamation_view', {id: reclamation.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                    {% else %}
                        <a href="{{ path('app_front_reclamations') }}" class="btn btn-outline-secondary">Annuler</a>
                    {% endif %}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
