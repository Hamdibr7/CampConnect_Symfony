{% extends 'base.html.twig' %}

{% block title %}Mes Réclamations{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes Réclamations</h1>
        <a href="{{ path('app_front_reclamation_new') }}" class="btn btn-primary">
            Nouvelle Réclamation
        </a>
    </div>

    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    {# Zone de recherche et tri #}
    <div class="mb-4">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Rechercher..." value="{{ app.request.get('search') }}">
            </div>
            <div class="col-md-3">
                <select name="search_by" class="form-select">
                    <option value="">Rechercher par...</option>
                    <option value="status" {{ app.request.get('search_by') == 'status' ? 'selected' }}>Par Statut</option>
                    <option value="description" {{ app.request.get('search_by') == 'description' ? 'selected' }}>Par Description</option>
                    <option value="camping" {{ app.request.get('search_by') == 'camping' ? 'selected' }}>Par Camp</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="order" class="form-select">
                    <option value="ASC" {{ app.request.get('order') == 'ASC' ? 'selected' }}>Trie Asc</option>
                    <option value="DESC" {{ app.request.get('order') == 'DESC' ? 'selected' }}>Trie Desc</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Rechercher</button>
            </div>
        </form>
    </div>

    {# Affichage des réclamations #}
    <div class="row">
        {% for reclamation in reclamations %}
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Réclamation #{{ reclamation.id }}</h5>
                        <p class="card-text">{{ reclamation.description }}</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-{{ reclamation.status == 'Traité' ? 'success' : (reclamation.status == 'En cours' ? 'warning' : 'info') }}">
                                {{ reclamation.status }}
                            </span>
                            <small class="text-muted">Camping: {{ reclamation.camping.nom }}</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_front_reclamation_view', {id: reclamation.id}) }}" class="btn btn-outline-primary btn-sm">
                                Voir les détails
                            </a>
                            <a href="{{ path('app_front_reclamation_edit', {id: reclamation.id}) }}" class="btn btn-outline-secondary btn-sm">
                                Modifier
                            </a>
                            <form method="post" action="{{ path('app_front_reclamation_delete', {id: reclamation.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    Vous n'avez pas encore de réclamations.
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
