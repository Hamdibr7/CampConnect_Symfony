{% extends 'base.html.twig' %}

{% block title %}Réclamation #{{ reclamation.id }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_front_reclamations') }}">Mes Réclamations</a></li>
            <li class="breadcrumb-item active">Réclamation #{{ reclamation.id }}</li>
        </ol>
    </nav>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title mb-0">Détails de la Réclamation</h3>
        </div>
        <div class="card-body">
            <h5>Description</h5>
            <p>{{ reclamation.description }}</p>

            <h5>Statut</h5>
            <p>
                <span class="badge bg-{{ reclamation.status == 'Traité' ? 'success' : (reclamation.status == 'En cours' ? 'warning' : 'info') }}">
                    {{ reclamation.status }}
                </span>
            </p>

            <h5>Camping</h5>
            <p>{{ reclamation.camping.nom }}</p>

            <div class="mt-3">
                <a href="{{ path('app_front_reclamation_edit', {id: reclamation.id}) }}" class="btn btn-outline-primary">
                    Modifier la réclamation
                </a>
                <form method="post" action="{{ path('app_front_reclamation_delete', {id: reclamation.id}) }}" class="d-inline ms-2" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?');">
                    <button type="submit" class="btn btn-outline-danger">Supprimer la réclamation</button>
                </form>
            </div>
        </div>
    </div>

    {% if reclamation.tickets|length > 0 %}
        {% set ticket = reclamation.tickets|first %}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Ticket</h3>
            </div>
            <div class="card-body">
                <p>{{ ticket.description }}</p>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Créé le {{ ticket.dateCreat|date('d/m/Y') }}</small>
                    <span class="badge bg-{{ ticket.status == 'Traité' ? 'success' : (ticket.status == 'En cours' ? 'warning' : 'info') }}">
                        {{ ticket.status }}
                    </span>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning">
            Aucun ticket trouvé pour cette réclamation.
        </div>
    {% endif %}
</div>
{% endblock %}
