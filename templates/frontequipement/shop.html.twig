<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>CampConnect</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free HTML Templates" name="keywords">
    <meta content="Free HTML Templates" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        .package-item {
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        
        .package-item .img-container {
            height: 200px; /* Hauteur fixe pour toutes les images */
            overflow: hidden;
            position: relative;
        }
        
        .package-item .img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Pour garder les proportions des images */
        }
        
        .package-item .p-4 {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        
        .package-item .description-container {
            height: 80px; /* Hauteur fixe pour les descriptions */
            overflow: auto;
            margin-bottom: 10px;
        }
        
        .border-top {
            margin-top: auto !important;
        }
     
        .badge-danger {
            animation: pulse 1.5s infinite;
        }
        
        .container-fluid.py-5 {
            min-height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        
        /* Pagination styling */
        .pagination {
            display: flex;
            justify-content: center;
            list-style: none;
            padding-left: 0;
            margin-top: 20px;
            gap: 8px;
        }
        
        .pagination li > a,
        .pagination li > span {
            padding: 8px 12px;
            border-radius: 5px;
            background: #f1f1f1;
            border: 1px solid #ddd;
            color: #333;
            text-decoration: none;
            transition: background 0.2s ease;
        }
        
        .pagination li > a:hover {
            background: #e9e9e9;
        }
        
        .pagination .current {
            background-color: #28a745;
            color: white;
            font-weight: bold;
            border-color: #28a745;
        }
        
        .pagination .current:hover {
            background-color: #218838;
            color: white;
        }
    </style>
</head>

<body>
    <!-- Topbar Start -->
    <div class="container-fluid bg-light pt-3 d-none d-lg-block">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 text-center text-lg-left mb-2 mb-lg-0">
                    <div class="d-inline-flex align-items-center">
                        <p><i class="fa fa-envelope mr-2"></i>info@example.com</p>
                        <p class="text-body px-3">|</p>
                        <p><i class="fa fa-phone-alt mr-2"></i>+012 345 6789</p>
                    </div>
                </div>
                <div class="col-lg-6 text-center text-lg-right">
                    <div class="d-inline-flex align-items-center">
                        <a class="text-primary px-3" href="#">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a class="text-primary px-3" href="#">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a class="text-primary px-3" href="#">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a class="text-primary px-3" href="#">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a class="text-primary pl-3" href="#">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->

    <!-- Navbar Start -->
    <div class="container-fluid position-relative nav-bar p-0">
        <div class="container-lg position-relative p-0 px-lg-3" style="z-index: 9;">
            <nav class="navbar navbar-expand-lg bg-light navbar-light shadow-lg py-3 py-lg-0 pl-3 pl-lg-5">
                <a href="/" class="navbar-brand">
                    <h1 class="m-0 text-primary"><span class="text-dark">CAMP</span>CONNECT</h1>
                </a>
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between px-3" id="navbarCollapse">
                    <div class="navbar-nav ml-auto py-0">
                        <a href="/" class="nav-item nav-link ">Accueil</a>
                        <a href="/about" class="nav-item nav-link">À propos</a>
                        <a href="/mon-compte/commandes" class="nav-item nav-link">Mes commandes</a>
                        <a href="/equipement/shop" class="nav-item nav-link active">Shop</a>

                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Autres</a>
                            <div class="dropdown-menu border-0 rounded-0 m-0">
                                <a href="/blog" class="dropdown-item">Blog</a>
                                <a href="/guides" class="dropdown-item">Guides</a>
                                <a href="/destinations" class="dropdown-item">Destinations</a>
                                <a href="/avis" class="dropdown-item">Avis</a>
                            </div>
                        </div>
                        <a href="/contact" class="nav-item nav-link">Contact</a>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- Navbar End -->

    <!-- Header Start -->
    <div class="container-fluid page-header">
        <div class="container">
            <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 400px">
                <h3 class="display-4 text-white text-uppercase">Le shop ou vous trouverez tout vos outils de camping</h3>
            </div>
        </div>
    </div>
    <!-- Header End -->

    <!-- Formulaire de recherche modifié pour AJAX -->
    <form id="searchForm" class="my-4">
        <div class="d-flex justify-content-center">
            <div class="input-group" style="max-width: 500px; width: 100%;">
                <input type="text" name="q" id="searchInput" class="form-control rounded-start border-end-0 shadow-sm" placeholder="🔍 Rechercher un équipement..." value="{{ searchTerm|default('') }}">
                <button id="searchButton" class="btn btn-success rounded-end" type="button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </form>

    <!-- Indicateur de chargement -->
    <div id="loadingIndicator" class="text-center my-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Chargement...</span>
        </div>
    </div>

    <!-- Packages Start -->
    <div class="container-fluid py-5">
        <div class="container pt-5 pb-3">
            <div class="text-center mb-3 pb-3">
                <h6 class="text-primary text-uppercase" style="letter-spacing: 5px;">NOS EQUIPEMENTS</h6>
                <h1>Trouvez les meilleurs équipements de camping</h1>
            </div>
            <div id="equipementContainer">
                <div class="row">
                    {% for equipement in equipements %}
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="package-item bg-white mb-2">
                            <div class="img-container position-relative">
                                <img class="img-fluid" src="{{ asset('uploads/equipements/' ~ equipement.image) }}" alt="{{ equipement.nomEquip }}">
                                {% if equipement.qte_dispo == 0 %}
                                    <div class="position-absolute w-100 text-center bg-danger text-white font-weight-bold py-1" style="bottom: 0; opacity: 0.9;">
                                        🚫 En rupture de stock
                                    </div>
                                {% endif %}
                            </div>
                            <div class="p-4">
                                <div class="d-flex justify-content-between mb-3">
                                    <small class="m-0"><i class="fa fa-box text-primary mr-2"></i>{{ equipement.qte_dispo }} disponibles</small>
                                    <small class="m-0"><i class="fas fa-tags text-primary mr-2"></i>{{ equipement.prix }} DT</small>
                                    <input type="hidden" class="equipement-id" value="{{ equipement.id }}">
                                    <input type="hidden" class="prix-unitaire" value="{{ equipement.prix }}">
                                </div>
                                <a class="h5 text-decoration-none" href="#">{{ equipement.nomEquip }}</a>
                                <div class="description-container">
                                    <p class="mt-2">{{ equipement.description }}</p>
                                </div>

                                {% if equipement.qte_dispo > 0 %}
                                    <div class="border-top mt-4 pt-4">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="input-group quantity-selector" style="width: 120px;">
                                                <div class="input-group-prepend">
                                                    <button class="btn btn-outline-primary btn-minus" type="button">
                                                        <i class="fa fa-minus"></i>
                                                    </button>
                                                </div>
                                                <input type="text" class="form-control text-center quantity-input" value="1" min="1" max="{{ equipement.qte_dispo }}">
                                                <div class="input-group-append">
                                                    <button class="btn btn-outline-primary btn-plus" type="button">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <button class="btn btn-primary btn-sm btn-add-to-cart">Ajouter au panier</button>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="mt-4 text-center">
                                        <span class="badge badge-danger py-2 px-3" style="font-size: 1rem;">
                                            ❌ Article indisponible
                                        </span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="col-12 text-center mt-4">
                        <p class="text-muted">Aucun résultat ne correspond à votre recherche.</p>
                    </div>
                    {% endfor %}
                </div> <!-- Close .row -->

                <!-- Always visible pagination block -->
                <div class="container">
                    <div class="d-flex justify-content-center mt-5 mb-4">
                        {{ knp_pagination_render(equipements) }}
                    </div>
                </div>
            </div> <!-- Close #equipementContainer -->
        </div>
    </div>
    <!-- Packages End -->

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-white-50 py-5 px-sm-3 px-lg-5" style="margin-top: 90px;">
        <div class="row pt-5">
            <div class="col-lg-3 col-md-6 mb-5">
                <a href="" class="navbar-brand">
                    <h1 class="text-primary"><span class="text-white">CAMP</span>CONNECT</h1>
                </a>
                <p>shop Camp Connect – Votre boutique en ligne spécialisée dans les équipements de camping de qualité. Découvrez notre sélection de tentes, sacs de couchage, réchauds et accessoires outdoor pour toutes vos aventures en pleine nature. Livraison rapide et conseils d'experts pour des expéditions réussies !</p>
            </div>
        </div>
    </div>
    <div class="container-fluid bg-dark text-white border-top py-4 px-sm-3 px-md-5" style="border-color: rgba(256, 256, 256, .1) !important;">
        <div class="row">
            <div class="col-lg-6 text-center text-md-left mb-3 mb-md-0">
                <p class="m-0 text-white-50">Copyright &copy; <a href="#">Domain</a>. All Rights Reserved.</p>
            </div>
        </div>
    </div>
    <!-- Footer End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="fa fa-angle-double-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/easing/easing.min.js"></script>
    <script src="/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/lib/tempusdominus/js/moment.min.js"></script>
    <script src="/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <!-- Template Javascript -->
    <script src="/js/main.js"></script>

    <script>
    // Variables globales pour le panier
    let cart = [];
    let total = 0;
    let cartPopup;

    // Fonction pour gérer les boutons de quantité (rendue globale)
    function handleQuantityButtons() {
        document.querySelectorAll('.btn-plus').forEach(button => {
            button.addEventListener('click', function () {
                const input = this.closest('.quantity-selector').querySelector('.quantity-input');
                let value = parseInt(input.value);
                const max = parseInt(input.getAttribute('max')) || 99;
                if (value < max) input.value = value + 1;
            });
        });

        document.querySelectorAll('.btn-minus').forEach(button => {
            button.addEventListener('click', function () {
                const input = this.closest('.quantity-selector').querySelector('.quantity-input');
                let value = parseInt(input.value);
                if (value > 1) input.value = value - 1;
            });
        });

        document.querySelectorAll('.btn-add-to-cart').forEach(button => {
            button.addEventListener('click', function () {
                const card = this.closest('.package-item');
                const name = card.querySelector('a')?.textContent.trim() || 'Produit';
                const image = card.querySelector('img')?.src || '';
                const quantityInput = card.querySelector('.quantity-input');
                const quantity = parseInt(quantityInput.value);
                const prixUnitaire = parseFloat(card.querySelector('.prix-unitaire').value);
                const equipementId = parseInt(card.querySelector('.equipement-id').value);

                const existing = cart.find(p => p.id === equipementId);
                if (existing) {
                    existing.quantity += quantity;
                } else {
                    cart.push({ id: equipementId, name, price: prixUnitaire, quantity, image });
                }

                total += prixUnitaire * quantity;
                updateCart();
                cartPopup.style.display = 'block';
            });
        });
    }





    // Fonction pour la recherche AJAX
    function performSearch() {
        const searchInput = document.getElementById('searchInput');
        const searchTerm = searchInput.value;
        const loadingIndicator = document.getElementById('loadingIndicator');
        const equipementContainer = document.getElementById('equipementContainer');
        
        // Afficher l'indicateur de chargement
        loadingIndicator.style.display = 'block';
        
        // Construire l'URL avec les paramètres de recherche
        const url = `/equipement/shop?q=${encodeURIComponent(searchTerm)}&ajax=1`;
        
        // Effectuer la requête AJAX
        fetch(url)
            .then(response => response.json())
            .then(data => {
                // Cacher l'indicateur de chargement
                loadingIndicator.style.display = 'none';
                
                // Mettre à jour le contenu avec les résultats
                equipementContainer.innerHTML = data.html;
                
                // Réinitialiser les gestionnaires d'événements pour les nouveaux éléments
                handleQuantityButtons();
                
                // Mettre à jour l'URL du navigateur sans recharger la page
                const newUrl = `/equipement/shop?q=${encodeURIComponent(searchTerm)}`;
                history.pushState({}, '', newUrl);
            })
            .catch(error => {
                console.error('Erreur lors de la recherche:', error);
                loadingIndicator.style.display = 'none';
                alert('Une erreur est survenue lors de la recherche.');
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Initialisation du panier
        cart = [];
        total = 0;

        // Création du popup pour le panier
        cartPopup = document.createElement('div');
        cartPopup.id = 'cartPopup';
        cartPopup.className = 'position-fixed bg-white shadow-lg p-3';
        cartPopup.style = 'top: 20px; right: 20px; width: 300px; z-index: 1050; display: none;';
        cartPopup.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0">Votre panier</h5>
                <button class="btn btn-sm btn-outline-danger" id="closeCart">&times;</button>
            </div>
            <div id="cartItems" class="mb-3"></div>
            <div class="d-flex justify-content-between align-items-center border-top pt-2">
                <strong>Total:</strong>
                <span id="cartTotal" class="font-weight-bold">0 DT</span>
            </div>
            <button id="validateOrder" class="btn btn-success btn-block mt-2">Valider la commande</button>
        `;
        document.body.appendChild(cartPopup);

        document.getElementById('closeCart').addEventListener('click', function () {
            cartPopup.style.display = 'none';
        });

        document.getElementById('validateOrder').addEventListener('click', function () {
            if (cart.length === 0) {
                alert('Votre panier est vide. Veuillez ajouter des articles avant de valider.');
                return;
            }

            fetch('/panier/valider', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(cart)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Commande enregistrée avec succès !');
                    cart.length = 0;
                    total = 0;
                    updateCart();
                    cartPopup.style.display = 'none';

                    // ✅ Bonus: recharger pour mettre à jour les quantités
                    window.location.href = '/equipement/shop';
                } else {
                    alert('❌ Erreur : ' + (data.error || 'Une erreur est survenue.'));
                }
            })
            .catch(error => {
                console.error('Erreur lors de la validation', error);
                alert('❌ Une erreur réseau est survenue.');
            });
        });

        // Configuration du formulaire de recherche pour AJAX
        const searchForm = document.getElementById('searchForm');
        const searchButton = document.getElementById('searchButton');
        const searchInput = document.getElementById('searchInput');

        // Événement de clic sur le bouton de recherche
        searchButton.addEventListener('click', function(e) {
            e.preventDefault();
            performSearch();
        });
        
        // Événement de soumission du formulaire
        searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            performSearch();
        });
        
        // Recherche dynamique après un délai de frappe
        let searchTimeout;
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(performSearch, 500); // Délai de 500ms
        });

        // Initialiser les gestionnaires d'événements
        handleQuantityButtons();
    });

    function updateCart() {
        const cartItems = document.getElementById('cartItems');
        cartItems.innerHTML = '';

        cart.forEach((item, index) => {
            cartItems.innerHTML += `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <img src="${item.image}" alt="${item.name}" style="width: 40px; height: 40px; object-fit: cover;" class="mr-2">
                    <div>
                        <div class="font-weight-bold">${item.name}</div>
                        <small>Prix: ${item.price} DT</small>
                    </div>
                    <input type="number" class="cart-quantity-input" value="${item.quantity}" min="1" max="99" data-index="${index}" style="width: 60px; text-align: center;">
                    <div class="font-weight-bold ml-3">${(item.quantity * item.price).toFixed(2)} DT</div>
                    <button class="btn btn-sm btn-outline-danger delete-item" data-index="${index}">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;
        });

        document.getElementById('cartTotal').textContent = total.toFixed(2) + ' DT';

        document.querySelectorAll('.delete-item').forEach(button => {
            button.addEventListener('click', function () {
                const index = parseInt(this.dataset.index);
                total -= cart[index].price * cart[index].quantity;
                cart.splice(index, 1);
                updateCart();
            });
        });

        document.querySelectorAll('.cart-quantity-input').forEach(input => {
            input.addEventListener('input', function () {
                const index = parseInt(this.dataset.index);
                const newQuantity = parseInt(this.value) || 1;
                cart[index].quantity = newQuantity;
                total = cart.reduce((acc, item) => acc + item.price * item.quantity, 0);
                updateCart();
            });
        });
    }
    </script>
</body>
</html>