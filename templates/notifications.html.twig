{% extends 'base.html.twig' %}

{% block title %}Mes Notifications - Camping Nature{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Roboto', sans-serif;
        }
        
        .page-header {
            background-color: #4c956c;
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .notification-title {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 1.2em;
        }
        
        .notification-icon {
            color: #fff;
            font-size: 2rem;
            background-color: #2c6e49;
            padding: 12px;
            border-radius: 50%;
        }
        
        .list-group-item {
            border-left: 5px solid #2c6e49;
            margin-bottom: 0.8rem;
            padding: 1rem;
            transition: all 0.3s ease;
            border-radius: 0.5rem;
        }
        
        .list-group-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        
        .list-group-item-primary {
            background-color: rgba(76, 149, 108, 0.1);
            border-left: 5px solid #ffc107;
        }
        
        .btn-outline-primary {
            color: #2c6e49;
            border-color: #2c6e49;
            border-width: 2px;
            font-weight: 600;
            padding: 0.5rem 1rem;
            transition: all 0.3s ease;
        }
        
        .btn-outline-primary:hover {
            background-color: #2c6e49;
            border-color: #2c6e49;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(44, 110, 73, 0.2);
        }
        
        .notification-header {
            margin: 2rem 0 1.2rem 0;
            color: #2c6e49;
            font-weight: 700;
            font-size: 1.4rem;
            border-bottom: 2px solid #4c956c;
            padding-bottom: 0.5rem;
            display: inline-block;
        }
        
        .camping-icon {
            margin-right: 0.5rem;
        }
        
        .notification-message {
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }
        
        .notification-date {
            font-style: italic;
            color: #6c757d;
        }
        
        .back-button {
            margin-bottom: 1.5rem;
            color: #2c6e49;
            border-color: #2c6e49;
            transition: all 0.3s ease;
        }
        
        .back-button:hover {
            background-color: #2c6e49;
            color: white;
            transform: translateX(-5px);
        }
        
        .notification-count {
            background-color: #ffc107;
            color: #212529;
            border-radius: 50%;
            padding: 0.2rem 0.6rem;
            font-size: 0.9rem;
            font-weight: 700;
            margin-left: 0.5rem;
        }
        
        .notification-actions {
            margin-top: 2rem;
            display: flex;
            justify-content: center;
            gap: 1rem;
        }
        
        .empty-notifications {
            text-align: center;
            padding: 3rem;
            background-color: rgba(76, 149, 108, 0.05);
            border-radius: 0.5rem;
            border: 1px dashed #4c956c;
        }
        
        .empty-icon {
            font-size: 3rem;
            color: #4c956c;
            margin-bottom: 1rem;
        }
        
        @media (min-width: 768px) {
            .container {
                max-width: 90%;
            }
        }
        
        @media (min-width: 992px) {
            .container {
                max-width: 80%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <!-- Bouton retour -->
        <a href="javascript:history.back()" class="btn btn-outline-secondary back-button mb-4">
            <i class="fas fa-arrow-left me-2"></i>
            Retour à la page précédente
        </a>
        
        <div class="page-header">
            <div class="container">
                <div class="notification-title">
                    <i class="fas fa-bell notification-icon"></i>
                    <h1>Mes Notifications</h1>
                </div>
            </div>
        </div>
        
        {% if notifications|length > 0 %}
            {# Compter les notifications non lues #}
            {% set unreadCount = 0 %}
            {% for notification in notifications %}
                {% if not notification.isRead %}
                    {% set unreadCount = unreadCount + 1 %}
                {% endif %}
            {% endfor %}
            
            {# Afficher les notifications non lues #}
            {% if unreadCount > 0 %}
                <h4 class="notification-header">Non lues <span class="notification-count">{{ unreadCount }}</span></h4>
                <div class="list-group mb-4">
                    {% for notification in notifications %}
                        {% if not notification.isRead %}
                            <div class="list-group-item list-group-item-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="notification-message">
                                            <i class="fas fa-info-circle me-2"></i>
                                            {{ notification.message }}
                                        </div>
                                        <small class="notification-date">
                                            <i class="far fa-clock me-1"></i>
                                            {{ notification.dateCreation|date('d/m/Y H:i') }}
                                        </small>
                                    </div>
                                    <a href="{{ path('app_notification_mark_as_read', {'id': notification.id}) }}" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-check me-1"></i>
                                        Marquer comme lu
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
            
            {# Compter les notifications lues #}
            {% set readCount = notifications|length - unreadCount %}
            
            {# Afficher les notifications lues si elles existent #}
            {% if readCount > 0 %}
                <h4 class="notification-header">Lues <span class="notification-count">{{ readCount }}</span></h4>
                <div class="list-group">
                    {% for notification in notifications %}
                        {% if notification.isRead %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="notification-message">
                                            <i class="fas fa-check-circle me-2 text-success"></i>
                                            {{ notification.message }}
                                        </div>
                                        <small class="notification-date">
                                            <i class="far fa-clock me-1"></i>
                                            {{ notification.dateCreation|date('d/m/Y H:i') }}
                                        </small>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
            
            {# Boutons d'action #}
            <div class="notification-actions">
                {% if unreadCount > 0 %}
                    <button id="mark-all-read" class="btn btn-outline-primary">
                        <i class="fas fa-check-double me-1"></i>
                        Tout marquer comme lu
                    </button>
                {% endif %}
                
                {% if notifications|length > 0 %}
                    <a href="#" class="btn btn-outline-secondary">
                        <i class="fas fa-trash-alt me-1"></i>
                        Effacer l'historique
                    </a>
                {% endif %}
            </div>
            
        {% else %}
            <div class="empty-notifications">
                <i class="fas fa-bell-slash empty-icon"></i>
                <h3>Aucune notification</h3>
                <p class="text-muted">Vous n'avez actuellement aucune notification à consulter.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation d'entrée pour les notifications
            const notifications = document.querySelectorAll('.list-group-item');
            notifications.forEach((notification, index) => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    notification.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    notification.style.opacity = '1';
                    notification.style.transform = 'translateY(0)';
                }, 100 * index);
            });
            
            // Gestion du bouton "Tout marquer comme lu"
            const markAllReadBtn = document.getElementById('mark-all-read');
            if (markAllReadBtn) {
                markAllReadBtn.addEventListener('click', function() {
                    // Animation pour montrer l'action
                    markAllReadBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Traitement...';
                    markAllReadBtn.disabled = true;
                    
                    // Récupérer tous les boutons "Marquer comme lu" et cliquer sur le premier
                    const markAsReadButtons = document.querySelectorAll('.list-group-item-primary .btn-outline-primary');
                    if (markAsReadButtons.length > 0) {
                        window.location.href = markAsReadButtons[0].getAttribute('href');
                    }
                });
            }
        });
    </script>
{% endblock %}