<!-- Ajoutez ces styles dans la section <head> de votre fichier -->
<style>
    .package-item {
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .package-item .img-container {
        height: 200px; /* Hauteur fixe pour toutes les images */
        overflow: hidden;
        position: relative;
    }
    
    .package-item .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* Pour garder les proportions des images */
    }
    
    .package-item .p-4 {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    
    .package-item .description-container {
        height: 80px; /* Hauteur fixe pour les descriptions */
        overflow: auto;
        margin-bottom: 10px;
    }
    
    .border-top {
        margin-top: auto !important;
    }
 
.badge-danger {
    animation: pulse 1.5s infinite;
}

@keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.9; }
    100% { transform: scale(1); opacity: 1; }
}


</style>

<!-- ... [Reste du code inchangé jusqu'à la section Packages] ... -->

{% block body %}
<!-- Header Start -->
<div class="container-fluid page-header">
    <div class="container">
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
            <h3 class="display-4 text-white text-uppercase">Vos Commandes</h3>
        </div>
    </div>
</div>
<!-- Header End -->

<div class="container py-5">
    <div class="text-center mb-5">
        <h6 class="text-primary text-uppercase" style="letter-spacing: 5px;">MES COMMANDES</h6>
        <h2>Historique de vos paniers</h2>
    </div>

    {% if paniers is empty %}
        <div class="alert alert-info text-center">Vous n'avez pas encore de commandes enregistrées.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center">
                <thead class="bg-success text-white">
                    <tr>
                      
                        <th>Image</th>
                        <th>Équipement</th>
                        <th>Quantité</th>
                        <th>Total</th>
                        <th>Payer</th>
                    </tr>
                </thead>
                <tbody>
                    {% for panier in paniers %}
                        <tr>
                           
                            <td>
                                {% if panier.equipement.image %}
                                    <img src="{{ asset('uploads/equipements/' ~ panier.equipement.image) }}" alt="Image" width="60" height="60" style="object-fit: cover; border-radius: 4px;">
                                {% else %}
                                    <i class="fas fa-image text-muted"></i>
                                {% endif %}
                            </td>
                            <td>{{ panier.equipement.nomEquip }}</td>
                            <td>{{ panier.quantite }}</td>
                            <td>{{ panier.prixTotal }} DT</td>
                            <td>
                               <form action="{{ path('stripe_create_session') }}" method="POST">
                                    <input type="hidden" name="panierId" value="{{ panier.id }}">
                                    <button type="submit" class="btn btn-success btn-sm btn-pay">
                                        <i class="fas fa-credit-card"></i> Payer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
