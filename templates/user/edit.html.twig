  <!-- Script personnalisé pour l'animation -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Animation pour les éléments avec la classe animate-up
      const animatedElements = document.querySelectorAll('.animate-up');
      animatedElements.forEach((element) => {
        element.style.opacity = 0;
      });

      setTimeout(() => {
        animatedElements.forEach((element, index) => {
          setTimeout(() => {
            element.style.opacity = 1;
          }, 100 * index);
        });
      }, 300);

      // Sélection des champs du formulaire
      const emailField = document.querySelector('[name$="[email]"]');
      const passwordField = document.querySelector('[name$="[mdp]"]');
      const confirmPasswordField = document.querySelector('[name$="[confirmPassword]"]');
      const lastNameField = document.querySelector('[name$="[nom]"]');
      const firstNameField = document.querySelector('[name$="[prenom]"]');
      const ageField = document.querySelector('[name$="[age]"]');

      // Fonction pour créer et afficher les messages d'erreur
      function showError(inputElement, message) {
        // Supprime d'abord tout message d'erreur existant
        const existingError = inputElement.parentElement.querySelector('.form-error');
        if (existingError) {
          existingError.remove();
        }

        // Crée et ajoute le nouveau message d'erreur
        const errorElement = document.createElement('div');
        errorElement.classList.add('form-error');
        errorElement.textContent = message;
        inputElement.parentElement.appendChild(errorElement);

        // Ajoute une bordure rouge au champ
        inputElement.style.borderColor = '#e74c3c';
      }

      // Fonction pour supprimer les messages d'erreur
      function removeError(inputElement) {
        const errorElement = inputElement.parentElement.querySelector('.form-error');
        if (errorElement) {
          errorElement.remove();
        }

        // Rétablit la bordure normale
        inputElement.style.borderColor = '#ddd';
      }

      // Fonction de validation d'email (doit être un Gmail)
      function validateEmail(email) {
        const regex = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;
        return regex.test(email);
      }

      // Fonction de validation de mot de passe
      function validatePassword(mdp) {
        const regex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]+$/;
        return regex.test(mdp);
      }

      // Fonction de validation de nom/prénom
      function validateName(nom) {
        if (nom.length > 7) {
          return { valid: false, message: "Ne doit pas dépasser 7 caractères." };
        }

        const regex = /^[A-Z][a-zA-Z]*$/;
        if (!regex.test(nom)) {
          return { valid: false, message: "Doit commencer par une majuscule et ne contenir que des lettres." };
        }

        return { valid: true };
      }

      // Fonction de validation d'âge
      function validateAge(age) {
        const ageNum = parseInt(age);
        if (isNaN(ageNum)) {
          return { valid: false, message: "L'âge doit être un nombre." };
        }

        if (ageNum < 10 || ageNum > 99) {
          return { valid: false, message: "L'âge doit être compris entre 10 et 99." };
        }

        return { valid: true };
      }

      // Validation de l'email
      if (emailField) {
        emailField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "L'email ne peut pas être vide.");
          } else if (!validateEmail(this.value)) {
            showError(this, "L'email doit être un Gmail valide (ex : nom@gmail.com).");
          } else {
            removeError(this);
          }
        });
      }

      if (passwordField) {
        passwordField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "Le mot de passe ne peut pas être vide.");
          } else if (!validatePassword(this.value)) {
            showError(this, "Le mot de passe doit contenir au moins une lettre et un chiffre.");
          } else {
            removeError(this);
          }
          
          // Vérifie également la confirmation du mot de passe si elle est remplie
          if (confirmPasswordField && confirmPasswordField.value) {
            if (confirmPasswordField.value !== this.value) {
              showError(confirmPasswordField, "Les mots de passe ne correspondent pas.");
            } else {
              removeError(confirmPasswordField);
            }
          }
        });
      }
      
      // Validation de la confirmation du mot de passe
      if (confirmPasswordField) {
        confirmPasswordField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "Veuillez confirmer votre mot de passe.");
          } else if (passwordField && this.value !== passwordField.value) {
            showError(this, "Les mots de passe ne correspondent pas.");
          } else {
            removeError(this);
          }
        });
      }
      
      // Validation du nom
      if (lastNameField) {
        lastNameField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "Le nom ne peut pas être vide.");
          } else {
            const validation = validateName(this.value);
            if (!validation.valid) {
              showError(this, validation.message);
            } else {
              removeError(this);
            }
          }
        });
      }
      
      // Validation du prénom
      if (firstNameField) {
        firstNameField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "Le prénom ne peut pas être vide.");
          } else {
            const validation = validateName(this.value);
            if (!validation.valid) {
              showError(this, validation.message);
            } else {
              removeError(this);
            }
          }
        });
      }
      
      // Validation de l'âge
      if (ageField) {
        ageField.addEventListener('input', function() {
          if (this.value.trim() === '') {
            showError(this, "L'âge ne peut pas être vide.");
          } else {
            const validation = validateAge(this.value);
            if (!validation.valid) {
              showError(this, validation.message);
            } else {
              removeError(this);
            }
          }
        });
      }
      
      // Validation du formulaire avant soumission
      const form = document.querySelector('.styled-form');
      if (form) {
        form.addEventListener('submit', function(event) {
          let hasErrors = false;
          
          // Vérifie tous les champs
          const fields = [emailField, passwordField, confirmPasswordField, lastNameField, firstNameField, ageField];
          
          fields.forEach(field => {
            if (field) {
              // Déclenche l'événement input pour valider tous les champs
              const inputEvent = new Event('input', { bubbles: true });
              field.dispatchEvent(inputEvent);
              
              // Vérifie si le champ a une erreur
              if (field.parentElement.querySelector('.form-error')) {
                hasErrors = true;
              }
            }
          });
          
          // Empêche la soumission si des erreurs sont présentes
          if (hasErrors) {
            event.preventDefault();
          }
        });
      }
    });
    
  </script>
</body>
</html>