  <style>
    /* Variables de couleurs */
    :root {
      --primary: #2ecc71;
      --secondary: #3498db;
      --accent: #f39c12;
      --light: #ecf0f1;
      --dark: #34495e;
    }

    body {
      font-family: 'Poppins', sans-serif;
      color: var(--dark);
      margin: 0;
      padding: 0;
    }

    .form-container {
      max-width: 450px;
      width: 100%;
      background-color: rgba(255, 255, 255, 0.95);
      border-radius: 15px;
      padding: 40px 30px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      margin: 40px auto;
    }

    .edit-profile-section {
      background-color: var(--light);
      background-image: url("/api/placeholder/400/320");
      background-size: cover;
      background-position: center;
      padding: 50px 0;
      min-height: 50vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    h1 {
      color: var(--primary);
      text-align: center;
      font-size: 32px;
      margin-bottom: 10px;
      text-transform: uppercase;
      position: relative;
    }

    .logo {
      text-align: center;
      font-size: 48px;
      margin-bottom: 20px;
    }

    .tagline {
      text-align: center;
      color: var(--dark);
      margin-bottom: 30px;
      font-size: 18px;
    }

    .form-group {
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
      color: var(--dark);
      font-size: 16px;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 15px;
      border: 2px solid #ddd;
      border-radius: 50px;
      font-size: 16px;
      transition: all 0.3s ease;
      box-sizing: border-box;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.2);
      outline: none;
    }

    .btn {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 15px 30px;
      font-size: 18px;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: block;
      width: 100%;
      margin: 30px 0 20px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
      box-shadow: 0 4px 6px rgba(46, 204, 113, 0.2);
    }

    .btn:hover {
      background-color: #27ae60;
      transform: translateY(-3px);
      box-shadow: 0 6px 12px rgba(46, 204, 113, 0.3);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .form-check {
      display: flex;
      align-items: center;
      margin: 8px 0;
    }

    .form-check input {
      width: auto;
      margin-right: 10px;
    }

    .form-error {
      color: #e74c3c;
      font-size: 14px;
      margin-top: 5px;
    }

    .login-link {
      text-align: center;
      margin-top: 20px;
      color: var(--dark);
      font-size: 15px;
    }

    .login-link a {
      color: var(--primary);
      text-decoration: none;
      font-weight: bold;
    }

    .login-link a:hover {
      text-decoration: underline;
    }

    .camping-icons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 25px;
      font-size: 22px;
    }

    .camping-icons span {
      animation: float 3s ease-in-out infinite;
    }

    .camping-icons span:nth-child(2) {
      animation-delay: 0.5s;
    }

    .camping-icons span:nth-child(3) {
      animation-delay: 1s;
    }

    .camping-icons span:nth-child(4) {
      animation-delay: 1.5s;
    }

    @keyframes float {
      0% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
      100% {
        transform: translateY(0);
      }
    }

    .password-requirements {
      font-size: 12px;
      color: #7f8c8d;
      margin-top: 5px;
      padding-left: 5px;
    }

    /* Correction pour le bouton d'inscription */
    button.btn {
      margin-top: 20px;
    }

    /* Alignement des éléments du formulaire */
    .styled-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .flash-message {
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-weight: bold;
      text-align: center;
      animation: fadeIn 0.4s ease;
    }

    .flash-success {
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }

    .flash-error {
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-up {
      animation: fadeInUp 0.6s ease forwards;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
