{# templates/home.html.twig #}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil - Camping Cool</title>
    <style>
        /* Variables de couleurs */
        :root {
            --primary: #2ecc71;
            --secondary: #3498db;
            --accent: #f39c12;
            --light: #ecf0f1;
            --dark: #34495e;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--light);
            background-image: url("{{ asset('images/background.jpg') }}");
            background-size: cover;
            margin: 0;
            padding: 20px;
            color: var(--dark);
            min-height: 100vh;
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            color: var(--primary);
            text-align: center;
            font-size: 32px;
            margin-bottom: 20px;
            text-transform: uppercase;
            position: relative;
        }

        h1:after {
            content: "🏕️";
            margin-left: 10px;
        }

        .welcome-message {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .user-profile {
            background-color: var(--light);
            border-radius: 10px;
            padding: 20px;
            margin: 30px auto;
            max-width: 400px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
        }

        .user-profile:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .user-avatar-container {
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
        }

       .user-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--primary);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

        .user-avatar:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
        }

        .user-avatar-placeholder {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background-color: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            font-weight: bold;
            color: white;
            border: 4px solid var(--primary);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
  


        .user-name {
            font-size: 24px;
            font-weight: bold;
            color: var(--dark);
            margin-bottom: 10px;
        }

        .user-info {
            font-size: 18px;
            color: var(--dark);
            margin-bottom: 20px;
        }

        .logout-btn {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 16px;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(243, 156, 18, 0.2);
        }

        .logout-btn:hover {
            background-color: #e67e22;
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(243, 156, 18, 0.3);
        }

        .camping-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 25px 0;
            font-size: 22px;
        }

        .camping-icons span {
            animation: float 3s ease-in-out infinite;
        }

        .camping-icons span:nth-child(2) {
            animation-delay: 0.5s;
        }

        .camping-icons span:nth-child(3) {
            animation-delay: 1s;
        }

        .camping-icons span:nth-child(4) {
            animation-delay: 1.5s;
        }

        .profile-edit-btn {
            background-color: var(--secondary);
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-top: 10px;
            font-weight: bold;
            box-shadow: 0 2px 4px rgba(52, 152, 219, 0.2);
        }

        .profile-edit-btn:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(52, 152, 219, 0.3);
        }

        @keyframes float {
            0% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0); }
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 14px;
            color: var(--dark);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Bienvenue sur Camping Cool</h1>
        
        <div class="camping-icons">
            <span>🏕️</span>
            <span>🌲</span>
            <span>⛺</span>
            <span>🌄</span>
        </div>
        
        <p class="welcome-message">Tu es connecté avec succès !</p>
        
        <div class="user-profile">
            <div class="user-avatar-container">
            {% if user is not null %}
                {% if user.pdp %}
                  <img class="user-avatar" src="{{ asset('uploads/profiles/' ~ user.pdp) }}" alt="Photo de profil">

                {% else %}
                    <div class="user-avatar-placeholder">
                        {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                    </div>
                {% endif %}
            </div>
            
            <div class="user-name">
                {{ user.prenom }} {{ user.nom }}
            </div>
            {% endif %}
            
            <a href="{{ path('app_utilisateur_edit', {'id': user.id}) }}" class="profile-edit-btn">Modifier mon profil</a>
        </div>
    
        <a href="{{ path('app_logout') }}" class="logout-btn">Se déconnecter</a>
        <a href="{{ path('app_amis') }}" class="profile-edit-btn" style="margin-right: 10px;">Mes amis</a>
        <div class="footer">
            <p>© 2025 Camping Cool - Tous droits réservés</p>
        </div>
    </div>
    
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation supplémentaire pour l'affichage de la page
            const container = document.querySelector('.container');
            container.style.opacity = '0';
            container.style.transform = 'translateY(20px)';
            container.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            
            setTimeout(function() {
                container.style.opacity = '1';
                container.style.transform = 'translateY(0)';
            }, 100);
            
            // Animation spécifique pour la photo de profil
            const userAvatar = document.querySelector('.user-avatar, .user-avatar-placeholder');
            if (userAvatar) {
                userAvatar.style.transform = 'scale(0.9)';
                userAvatar.style.opacity = '0';
                userAvatar.style.transition = 'transform 0.6s ease-out, opacity 0.6s ease-out';
                
                setTimeout(function() {
                    userAvatar.style.transform = 'scale(1)';
                    userAvatar.style.opacity = '1';
                }, 500);
            }
        });
    </script>
</body>
</html>